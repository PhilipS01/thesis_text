\contentsline {figure}{\numberline {A.1}{\ignorespaces Plot of the converged interface voltage of the third preset at 100 windows using the backward \textsc {Euler} discretisation and a voltage-driven field. The other parameters are the same as in Figure~\ref {fig:example-2-plots-voltage-acc}}}{25}{figure.caption.16}%
\contentsline {figure}{\numberline {A.2}{\ignorespaces Plot of the converged interface voltage of the fourth preset using the accumulated discretisation of the interface. 10 field evaluations and 200 circuit samples per window. The other parameters are the same as in Figure~\ref {fig:example-3-plot-voltage-acc}.}}{25}{figure.caption.17}%
