\newlabel{fig:example-1-schematics}{{5.1}{17}{Circuit schematics of the first two presets featuring low frequency sinusoidal sources. The ammeter measures the interface current \gls {iC}. They are schematics of the accumulated interface. If the naive interface is used, $\mathrm {field\,ROM}$ is comprised of only the lagged correction term and the ROM is inserted as circuit elements \lstinline |Rrom|, \lstinline |Lrom| in the netlist, see Chapter~\ref {sec:xyce-interface-condition}}{figure.caption.10}{}}
\newlabel{fig:example-1-plot-voltage}{{5.2a}{19}{Interface voltage of the converged solution. V(p) is the reconstructed circuit port voltage, containing 201 points per window here. V(field) is the reconstructed field port voltage, containing 11 points per window here}{figure.caption.11}{}}
\newlabel{sub@fig:example-1-plot-voltage}{{a}{19}{Interface voltage of the converged solution. V(p) is the reconstructed circuit port voltage, containing 201 points per window here. V(field) is the reconstructed field port voltage, containing 11 points per window here}{figure.caption.11}{}}
\newlabel{fig:example-1-plot-convergence}{{5.2b}{19}{WR iterations and relative error for each window}{figure.caption.11}{}}
\newlabel{sub@fig:example-1-plot-convergence}{{b}{19}{WR iterations and relative error for each window}{figure.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.2}{\ignorespaces Plots of the converged solution to the first preset using the \textquote {naive} backward \textsc  {Euler} interface discretisation with true field values $L=\qty {1.68}{\milli \henry }$, $R=\qty {0.5}{\milli \ohm }$ and ROM values $L_{\text  {ROM}}=\qty {1}{\milli \henry }$, $R_{\text  {ROM}}=\qty {0.4}{\milli \ohm }$. The \qty {20}{\milli \second } time span is divided into 50 windows and Xyce's solution was resampled to 200 points per window. The voltage-driven field was evaluated 10 times each window.}}{19}{figure.caption.11}\protected@file@percent }
\newlabel{fig:example-1-plots}{{5.2}{19}{Plots of the converged solution to the first preset using the \textquote {naive} backward \textsc {Euler} interface discretisation with true field values $L=\qty {1.68}{\milli \henry }$, $R=\qty {0.5}{\milli \ohm }$ and ROM values $L_{\text {ROM}}=\qty {1}{\milli \henry }$, $R_{\text {ROM}}=\qty {0.4}{\milli \ohm }$. The \qty {20}{\milli \second } time span is divided into 50 windows and Xyce's solution was resampled to 200 points per window. The voltage-driven field was evaluated 10 times each window}{figure.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.3}{\ignorespaces Circuit schematic of the third preset. The RLC circuit is being driven by a \qty {1}{\volt }/\qty {20}{\kilo \hertz } source that gets switched off (shorted over \qty {1}{\milli \ohm }) at \qty {1}{\milli \second }. Here depicted with the accumulated interface.}}{20}{figure.caption.12}\protected@file@percent }
\newlabel{fig:example-2-plot-voltage}{{5.4a}{21}{Interface discretised with backward \textsc {Euler}. Xyce's solution was resampled to 200 points per window. The voltage-driven field was evaluated 10 times each window}{figure.caption.13}{}}
\newlabel{sub@fig:example-2-plot-voltage}{{a}{21}{Interface discretised with backward \textsc {Euler}. Xyce's solution was resampled to 200 points per window. The voltage-driven field was evaluated 10 times each window}{figure.caption.13}{}}
\newlabel{fig:example-2-plot-voltage-acc}{{5.4b}{21}{Interface discretised with the accumulated method. Xyce's solution was resampled to one point per window. The voltage-driven field was evaluated once each window}{figure.caption.13}{}}
\newlabel{sub@fig:example-2-plot-voltage-acc}{{b}{21}{Interface discretised with the accumulated method. Xyce's solution was resampled to one point per window. The voltage-driven field was evaluated once each window}{figure.caption.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.4}{\ignorespaces Plots of the converged interface voltage to the third preset using the different interface discretisations with true field values $L=\qty {168}{\nano \henry }$, $R=\qty {0.5}{\milli \ohm }$ and ROM values $L_{\text  {ROM}}=\qty {150}{\nano \henry }$, $R_{\text  {ROM}}=\qty {0.4}{\milli \ohm }$. The \qty {1.6}{\milli \second } time span is divided into 100 windows. Voltage-driven field.}}{21}{figure.caption.13}\protected@file@percent }
\newlabel{fig:example-2-plots}{{5.4}{21}{Plots of the converged interface voltage to the third preset using the different interface discretisations with true field values $L=\qty {168}{\nano \henry }$, $R=\qty {0.5}{\milli \ohm }$ and ROM values $L_{\text {ROM}}=\qty {150}{\nano \henry }$, $R_{\text {ROM}}=\qty {0.4}{\milli \ohm }$. The \qty {1.6}{\milli \second } time span is divided into 100 windows. Voltage-driven field}{figure.caption.13}{}}
